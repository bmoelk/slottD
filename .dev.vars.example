# .dev.vars (Git-Ignored Local Development Variables)
# Copy this file to .dev.vars for local testing:
# cp .dev.vars.example .dev.vars

ENVIRONMENT="development"

# Briefcase Operator Identity (attributed in audit revisions & git commits)
OPERATOR_NAME="Local Operator"
OPERATOR_EMAIL="dev@localhost"

# Local-only random API key for local test suites / scripts.
# IMPORTANT: This is purely local. NEVER reuse or match staging/production keys!
ADMIN_API_KEY="local-briefcase-key-8f4b10ec"
JWT_SECRET="local-dev-jwt-secret-slottd-2026"

# Optional SlotWire preview secret
PREVIEW_SECRET="local-dev-preview-secret-2026"

# Optional local Studio admin password hash (HMAC-SHA256, keyed by ADMIN_API_KEY).
# NOTE: If a user changes or removes their password through SlottD Studio (/admin/settings),
# the active password is saved in the D1 database (system_settings table), which takes precedence
# and causes this ADMIN_PASSWORD_HASH value to be ignored.
# ADMIN_PASSWORD_HASH=""
