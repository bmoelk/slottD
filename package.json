{
  "name": "slottd",
  "version": "0.1.0",
  "description": "Ultra-lightweight edge-native micro-CMS for Cloudflare Workers, D1, and R2 — designed to slot directly into Astro and SlotWire.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./checks": "./src/checks/index.ts",
    "./*": "./src/*"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy -c wrangler.overrides.toml",
    "deploy:overrides": "wrangler deploy -c wrangler.overrides.toml",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.overrides.toml",
    "test": "vitest run",
    "build": "tsc",
    "prepare": "npm run build",
    "bridge": "npx tsx scripts/git-bridge.ts",
    "briefcase": "cargo run --manifest-path briefcase/Cargo.toml"
  },
  "keywords": [
    "cms",
    "cloudflare-workers",
    "cloudflare-d1",
    "astro",
    "slotwire",
    "directus",
    "hono",
    "kysely"
  ],
  "author": "SlotWire Team",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.0",
    "kysely": "^0.27.4",
    "kysely-d1": "^0.3.0"
  },
  "devDependencies": {
    "@alpinejs/sort": "^3.17.2",
    "@cloudflare/workers-types": "^4.20241022.0",
    "alpinejs": "^3.17.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^3.84.0"
  }
}
